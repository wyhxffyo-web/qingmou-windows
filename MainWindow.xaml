<Window x:Class="QingMou.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="轻眸 · 护眼提醒" Width="880" Height="615" MinWidth="730" MinHeight="530"
        WindowStartupLocation="CenterScreen" Background="#F5F8F5"
        FontFamily="Microsoft YaHei UI,Segoe UI" Foreground="#20352A"
        Closing="Window_Closing">
    <Window.Resources>
        <SolidColorBrush x:Key="Accent" Color="#57966F"/>
        <SolidColorBrush x:Key="Muted" Color="#778B7D"/>
        <Style x:Key="SoftButton" TargetType="Button">
            <Setter Property="Padding" Value="17,11"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#294633"/>
            <Setter Property="BorderBrush" Value="#D9E6DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.86"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.72"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource SoftButton}">
            <Setter Property="Background" Value="#57966F"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#57966F"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8,8"/>
            <Setter Property="BorderBrush" Value="#D8E5DA"/>
            <Setter Property="Background" Value="#F7FAF7"/>
            <Setter Property="Foreground" Value="#20352A"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="InputBorder" CornerRadius="9"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush" Value="#57966F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ModeChoice" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#687D6C"/>
            <Setter Property="Background" Value="#F2F6F2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="ChoiceBorder" Background="{TemplateBinding Background}"
                                BorderBrush="#E1EAE2" BorderThickness="1" CornerRadius="10" Padding="12,10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ChoiceBorder" Property="Background" Value="#E4F1E6"/>
                                <Setter TargetName="ChoiceBorder" Property="BorderBrush" Value="#57966F"/>
                                <Setter Property="Foreground" Value="#23633C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,0,0,13"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#536B59"/>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="34,28,34,28">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,25">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#57966F" Width="40" Height="40" CornerRadius="13" Margin="0,0,12,0">
                        <TextBlock Text="◒" Foreground="White" FontSize="28" TextAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="轻眸" FontSize="21" FontWeight="SemiBold"/>
                        <TextBlock Text="给眼睛留一点休息时间" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
                <Border Grid.Column="1" Background="#E6F2E8" CornerRadius="16" Padding="12,7" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="#57966F" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="StatusText" Text="正在专注" FontSize="11" Foreground="#3E7D51"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="0.9*"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,18,0">
                    <Border Background="#E7F1E8" CornerRadius="19" Padding="29" MinHeight="360">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="本轮专注" FontSize="13" FontWeight="SemiBold" Foreground="#4D7560"/>
                                <Border Grid.Column="1" Background="#F5FAF5" CornerRadius="12" Padding="10,5">
                                    <StackPanel Orientation="Horizontal"><TextBlock x:Name="CycleText" Text="20" FontSize="11" FontWeight="SemiBold" Foreground="#4D7560"/><TextBlock Text=" 分钟" FontSize="11" Foreground="#4D7560"/></StackPanel>
                                </Border>
                            </Grid>
                            <TextBlock Text="距离下次休息" FontSize="12" Foreground="#6D8B77" Margin="0,32,0,0"/>
                            <TextBlock x:Name="CountdownText" Text="20:00" FontSize="69" FontWeight="SemiBold" LineHeight="83" Margin="0,4,0,7"/>
                            <TextBlock x:Name="CaptionText" Text="保持专注，也记得放松眼睛" FontSize="12" Foreground="#6D8B77"/>
                            <ProgressBar x:Name="FocusProgress" Height="7" Margin="0,29,0,25" Minimum="0" Maximum="100" Value="0"
                                         Foreground="{StaticResource Accent}" Background="#D4E4D8"/>
                            <WrapPanel>
                                <Button x:Name="BreakNowButton" Content="立即休息" Click="BreakNow_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,9,8"/>
                                <Button x:Name="SnoozeButton" Content="稍后 10 分钟" Click="Snooze_Click" Style="{StaticResource SoftButton}" Margin="0,0,9,8"/>
                                <Button x:Name="PauseButton" Content="暂停提醒" Click="Pause_Click" Style="{StaticResource SoftButton}" Margin="0,0,0,8"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <Border Background="White" CornerRadius="15" BorderBrush="#E5ECE6" BorderThickness="1" Padding="19,15" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="今日记录" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <TextBlock x:Name="StatsText" Text="今日专注 0 分钟 · 完成休息 0 次" FontSize="11" Foreground="{StaticResource Muted}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <Border Background="White" CornerRadius="19" BorderBrush="#E5ECE6" BorderThickness="1" Padding="23,21">
                        <StackPanel>
                            <TextBlock Text="提醒设置" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Text="时间与显示方式随时可调整" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,4,0,21"/>
                            <Grid Margin="0,0,0,21">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="专注时长 / 分钟" FontSize="11" Foreground="#607666" Margin="0,0,0,8"/>
                                    <TextBox x:Name="FocusMinutesBox" LostFocus="SettingsField_LostFocus" KeyDown="SettingsField_KeyDown"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="休息时长 / 秒" FontSize="11" Foreground="#607666" Margin="0,0,0,8"/>
                                    <TextBox x:Name="BreakSecondsBox" LostFocus="SettingsField_LostFocus" KeyDown="SettingsField_KeyDown"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="提醒方式" FontSize="11" Foreground="#607666" Margin="0,0,0,9"/>
                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <RadioButton x:Name="PartialModeRadio" Content="小窗提醒" GroupName="ReminderMode" Style="{StaticResource ModeChoice}" Checked="SettingsToggle_Changed" Margin="0,0,5,0"/>
                                <RadioButton x:Name="FullModeRadio" Content="全屏提醒" GroupName="ReminderMode" Style="{StaticResource ModeChoice}" Checked="SettingsToggle_Changed" Grid.Column="1" Margin="5,0,0,0"/>
                            </Grid>
                            <Button Content="预览提醒" Click="Preview_Click" Style="{StaticResource SoftButton}" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>

                    <Border Background="White" CornerRadius="19" BorderBrush="#E5ECE6" BorderThickness="1" Padding="23,18" Margin="0,16,0,0">
                        <Expander Header="更多设置" Foreground="#20352A" FontSize="12" FontWeight="SemiBold">
                            <StackPanel Margin="0,18,0,0">
                                <TextBlock Text="提醒出现的时机" FontSize="11" FontWeight="SemiBold" Foreground="#57966F" Margin="0,0,0,13"/>

                                <StackPanel Margin="0,0,0,19">
                                    <CheckBox x:Name="FullscreenCheck" Content="使用全屏软件时暂缓提醒" Margin="0" Checked="SettingsToggle_Changed" Unchecked="SettingsToggle_Changed"/>
                                    <TextBlock Text="看视频或玩游戏时不打断；退出全屏后再提醒。" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Muted}" Margin="22,4,0,0"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,0,19">
                                    <CheckBox x:Name="IdleCheck" Content="离开电脑时暂停计时" Margin="0" Checked="SettingsToggle_Changed" Unchecked="SettingsToggle_Changed"/>
                                    <TextBlock Text="鼠标和键盘 5 分钟没有操作，就暂停计时；回来后继续。" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Muted}" Margin="22,4,0,0"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,0,19">
                                    <CheckBox x:Name="SoundCheck" Content="提醒时播放声音" Margin="0" Checked="SettingsToggle_Changed" Unchecked="SettingsToggle_Changed"/>
                                    <TextBlock Text="休息提醒出现时播放一次系统提示音。" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Muted}" Margin="22,4,0,0"/>
                                </StackPanel>

                                <Border Height="1" Background="#E9EFEA" Margin="0,0,0,18"/>
                                <TextBlock Text="休息安排" FontSize="11" FontWeight="SemiBold" Foreground="#57966F" Margin="0,0,0,13"/>

                                <StackPanel Margin="0,0,0,19">
                                    <TextBlock Text="稍后多久再提醒" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBlock Text="在休息提醒中点击「稍后」，就从这里设定的时间重新倒数。" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,4,0,9"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBox x:Name="SnoozeMinutesBox" Width="70" TextAlignment="Center" LostFocus="SettingsField_LostFocus" KeyDown="SettingsField_KeyDown"/>
                                        <TextBlock Text="分钟后再提醒" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="11"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Margin="0,0,0,19">
                                    <CheckBox x:Name="LongBreakCheck" Content="定期安排长休息" Margin="0" Checked="SettingsToggle_Changed" Unchecked="SettingsToggle_Changed"/>
                                    <TextBlock Text="每经过几轮专注，就将一次普通休息改为长休息。" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Muted}" Margin="22,4,0,10"/>
                                    <Grid Margin="22,0,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,10,0">
                                            <TextBlock Text="每隔几轮专注" FontSize="11" Foreground="#607666" Margin="0,0,0,6"/>
                                            <TextBox x:Name="LongEveryBox" TextAlignment="Center" IsEnabled="{Binding IsChecked, ElementName=LongBreakCheck}" LostFocus="SettingsField_LostFocus" KeyDown="SettingsField_KeyDown"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="休息几分钟" FontSize="11" Foreground="#607666" Margin="0,0,0,6"/>
                                            <TextBox x:Name="LongMinutesBox" TextAlignment="Center" IsEnabled="{Binding IsChecked, ElementName=LongBreakCheck}" LostFocus="SettingsField_LostFocus" KeyDown="SettingsField_KeyDown"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>

                                <StackPanel Margin="0,0,0,19">
                                    <CheckBox x:Name="QuietCheck" Content="指定时间不提醒" Margin="0" Checked="SettingsToggle_Changed" Unchecked="SettingsToggle_Changed"/>
                                    <TextBlock Text="这段时间内暂停专注计时；可以设置为跨越午夜。" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Muted}" Margin="22,4,0,10"/>
                                    <StackPanel Orientation="Horizontal" Margin="22,0,0,0">
                                        <TextBox x:Name="QuietStartBox" Width="83" Padding="5,8" TextAlignment="Center" IsEnabled="{Binding IsChecked, ElementName=QuietCheck}" LostFocus="SettingsField_LostFocus" KeyDown="SettingsField_KeyDown"/>
                                        <TextBlock Text="到" Margin="10,0" VerticalAlignment="Center" FontSize="11"/>
                                        <TextBox x:Name="QuietEndBox" Width="83" Padding="5,8" TextAlignment="Center" IsEnabled="{Binding IsChecked, ElementName=QuietCheck}" LostFocus="SettingsField_LostFocus" KeyDown="SettingsField_KeyDown"/>
                                    </StackPanel>
                                </StackPanel>

                                <Border Height="1" Background="#E9EFEA" Margin="0,0,0,18"/>
                                <CheckBox x:Name="AutoStartCheck" Content="登录 Windows 后自动启动" Margin="0" Checked="SettingsToggle_Changed" Unchecked="SettingsToggle_Changed"/>
                                <TextBlock Text="轻眸会在右下角系统托盘运行，无需每次手动打开。" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Muted}" Margin="22,4,0,0"/>
                            </StackPanel>
                        </Expander>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</Window>
