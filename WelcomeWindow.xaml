<Window x:Class="QingMou.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="欢迎使用轻眸" Width="510" Height="535" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Background="#F5F8F5"
        FontFamily="Microsoft YaHei UI,Segoe UI" Foreground="#20352A">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="19,12"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="31,28">
        <StackPanel>
            <Border Background="#57966F" CornerRadius="15" Width="52" Height="52" HorizontalAlignment="Left">
                <TextBlock Text="◒" Foreground="White" FontSize="37" TextAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="欢迎使用轻眸" FontSize="25" FontWeight="SemiBold" Margin="0,20,0,8"/>
            <TextBlock Text="轻量的 Windows 护眼提醒，按你的节奏休息。" FontSize="13" Foreground="#6C8171"/>
            <Border Background="White" BorderBrush="#E1EBE3" BorderThickness="1" CornerRadius="13" Padding="18" Margin="0,23,0,18">
                <StackPanel>
                    <TextBlock Text="初始设置" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <TextBlock Text="✓  屏幕提醒与托盘运行" FontSize="12" Margin="0,0,0,9"/>
                    <TextBlock Text="✓  离开电脑时自动暂停计时" FontSize="12" Margin="0,0,0,9"/>
                    <TextBlock Text="✓  全屏应用时暂缓提醒" FontSize="12" Margin="0,0,0,9"/>
                    <TextBlock Text="＋  可选：开机自动启动" FontSize="12"/>
                </StackPanel>
            </Border>
            <TextBlock Text="这些功能无需额外的 Windows 系统权限。一键启用会同时打开开机启动。"
                       FontSize="11" Foreground="#6C8171" TextWrapping="Wrap" Margin="0,0,0,17"/>
            <Button Content="一键启用推荐设置" Click="Enable_Click" Background="#57966F" Foreground="White"
                    BorderBrush="#57966F" HorizontalAlignment="Stretch"/>
            <Button Content="暂不开机启动，直接使用" Click="Continue_Click" Background="Transparent" Foreground="#5D7464"
                    BorderBrush="Transparent" HorizontalAlignment="Stretch" Margin="0,5,0,0"/>
        </StackPanel>
    </Grid>
</Window>
